generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  emailVerified   DateTime?
  name            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sessions        Session[]
  loginTokens     LoginToken[]
  bookingSessions BookingSession[]
  orders          Order[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model LoginToken {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  token     String   @unique
  expires   DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([email])
}

model BookingSession {
  id              String   @id @default(cuid())
  userId          String?
  type            String
  duffelOfferId   String?
  passengers      String?
  services        String?
  contact         String?
  paymentIntentId String?
  paymentClientToken String?
  totalAmount     String?
  currency        String?
  status          String   @default("draft")
  offerExpiresAt  DateTime?
  expiresAt       DateTime
  rawOffer        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  order           Order?
  @@index([status, expiresAt])
}

model Order {
  id                String   @id @default(cuid())
  userId            String?
  bookingSessionId  String?  @unique
  type              String
  duffelOrderId     String   @unique
  bookingReference  String
  status            String
  totalAmount       String
  currency          String
  contactEmail      String
  contactPhone      String?
  rawSnapshot       String
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  cancelledAt       DateTime?
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookingSession   BookingSession?  @relation(fields: [bookingSessionId], references: [id])
  events           OrderEvent[]
  payments         Payment[]
  @@index([userId, createdAt])
  @@index([status])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  source    String
  type      String
  payload   String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId, createdAt])
}

model Payment {
  id                    String   @id @default(cuid())
  orderId               String?
  bookingSessionId      String?
  duffelPaymentIntentId String?  @unique
  amount                String
  currency              String
  status                String
  raw                   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  order                 Order?   @relation(fields: [orderId], references: [id])
  @@index([orderId])
}

model WebhookEvent {
  id            String    @id @default(cuid())
  duffelEventId String    @unique
  type          String
  liveMode      Boolean
  payload       String
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?
  @@index([type, processedAt])
}

model Search {
  id          String   @id @default(cuid())
  userId      String?
  type        String
  payload     String
  resultCount Int      @default(0)
  durationMs  Int?
  createdAt   DateTime @default(now())
  @@index([type, createdAt])
}

model EmailLog {
  id          String   @id @default(cuid())
  to          String
  subject     String
  template    String
  providerId  String?
  status      String
  error       String?
  payload     String?
  createdAt   DateTime @default(now())
  @@index([to])
}
